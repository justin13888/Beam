.DS_Store

# Bun workspace
node_modules/

# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

.env
.todos/

# Per-developer mise overrides (e.g. BEAM_CARGO_FEATURES="" on hosts that have
# system FFmpeg development libraries installed)
mise.local.toml

# cargo-llvm-cov output
lcov.info

# Sidecar worktree state files
.sidecar/
.sidecar-agent
.sidecar-task
.sidecar-pr
.sidecar-start.sh
.sidecar-base
.td-root

# Apple client (#66). Everything here is generated by a `mise run` task and must
# not be committed: the XCFramework and the Swift bindings by `core:apple` and
# `core:bindgen:swift`, and the Xcode project by `apple:project` (XcodeGen reads
# the committed beam-apple/project.yml, which is the reviewable source of truth).
beam-apple/Packages/BeamKit/Frameworks/
beam-apple/Packages/BeamKit/Sources/BeamCoreBindings/Generated/
beam-apple/Beam.xcodeproj/
beam-apple/Version.xcconfig
beam-apple/build/
.swiftpm/
*.xcuserdatad
