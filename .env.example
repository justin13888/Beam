# =============================================================================
# Beam Deployment Configuration
# =============================================================================
# Copy this file to `.env` and customize the values for your deployment via
# Docker/Podman Compose. Full reference: docs/operations/configuration.md
#
# Optional variables are shown commented out. Leave them commented rather
# than setting them to an empty value: compose passes them through in list
# form, and an explicitly-empty string is NOT the same as unset for the
# server's optional settings (e.g. an empty BEAM_OIDC_ISSUER would make the
# server believe OIDC is configured against an empty issuer URL).
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres (compose-only; keep in sync with BEAM_DATABASE_URL)
# -----------------------------------------------------------------------------
POSTGRES_USER=beam
# Change in production.
POSTGRES_PASSWORD=password
POSTGRES_DB=beam
# Host port to expose Postgres on (mapped to 5432 in container)
POSTGRES_HOST_PORT=5432

# -----------------------------------------------------------------------------
# Beam server (full reference: docs/operations/configuration.md)
# -----------------------------------------------------------------------------
# Host port to expose the API server on
BEAM_SERVER_HOST_PORT=8000
# Externally-visible base URL of the API server (drives the OIDC redirect
# URL and the cookie-Secure heuristic; use the public HTTPS URL in
# production)
BEAM_SERVER_URL=http://localhost:8000
BEAM_DATABASE_URL=postgres://beam:password@postgres:5432/beam
RUST_LOG=beam_server=info
# In-container mount points for the read-only media library and the
# server-writable data directory
BEAM_VIDEO_DIR=/videos
BEAM_DATA_DIR=/data
# Host paths to mount; leave unset to use named volumes instead
#HOST_VIDEO_DIR=/path/to/your/media
#HOST_DATA_DIR=/path/to/beam/data
# Apply schema migrations automatically at startup
BEAM_AUTO_MIGRATE=true
BEAM_ENABLE_METRICS=false

# OIDC login (all three required together; login stays disabled with a clear
# error until they are set). Point at your identity provider; the bundled
# Dex from compose.dependencies.yaml is for local development only.
#BEAM_OIDC_ISSUER=https://idp.example.com
#BEAM_OIDC_CLIENT_ID=beam
#BEAM_OIDC_CLIENT_SECRET=change_me
# How Beam's client is registered to authenticate at the IdP's token and
# device endpoints: client_secret_basic (default) or client_secret_post.
#BEAM_OIDC_CLIENT_AUTH_METHOD=client_secret_basic
# Admin is granted by an IdP-asserted ID-token claim (issue #85), not the server.
# Name the claim (e.g. groups) and, for a value/array match, its expected value.
#BEAM_OIDC_ADMIN_CLAIM=groups
#BEAM_OIDC_ADMIN_VALUE=beam-admin

# Metadata enrichment (optional). Without a TMDB token, TMDB-eligible titles
# are left un-enriched; AniList enrichment works without any token.
#BEAM_TMDB_API_TOKEN=
BEAM_ANILIST_ENABLED=true

# Opt-in anonymous library telemetry (issue #93). Unset or empty sends nothing;
# there is no default collector. When set, an aggregate-only OTLP/HTTP JSON
# report is posted here weekly. Preview it at GET /v1/admin/telemetry/library.
#BEAM_TELEMETRY_URL=
# Operator-local playback telemetry (issue #143). Off by default; when on,
# signed-in clients may report playback starts, failures, rebuffers and source
# switches, kept only as daily aggregate counts (no user or file). The admin
# view is GET /v1/admin/telemetry/playback. Counts older than the retention
# window are pruned daily.
#BEAM_PLAYBACK_TELEMETRY_ENABLED=false
#BEAM_PLAYBACK_TELEMETRY_RETENTION_DAYS=365

# -----------------------------------------------------------------------------
# Beam web client (build-time Vite variables; deliberately NOT BEAM_-prefixed
# -- the client bundle inlines every variable matching its prefix, so server
# secrets must never share it)
# -----------------------------------------------------------------------------
# Host port to expose the web interface on
WEB_HOST_PORT=8080
C_APP_TITLE=Beam
# URL of the API server the browser connects to
C_STREAM_SERVER_URL=http://localhost:8000
