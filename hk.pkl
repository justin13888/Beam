amends "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Config.pkl"

// Git hooks for beam. Every non-trivial step shells out to a `mise run <task>`
// so the hooks, the GitHub Actions workflows, and a human at a terminal all run
// the exact same command. See mise.toml for the task definitions.
//
// Hooks are installed by `mise run setup` (or mise's postinstall hook), which
// runs `hk install --mise`. HK_MISE=1 in mise.toml wraps hook execution in
// `mise x`, so contributors without mise activated still get the pinned tools.

min_hk_version = "1.57.0"

default_branch = "master"

hooks {
    // Fast, staged-file-scoped, auto-fixing. Should finish in seconds: anything
    // that needs to compile Rust belongs in pre-push, not here.
    ["pre-commit"] {
        fix = true
        stage = true
        stash = "git"
        steps {
            ["rustfmt"] {
                glob = List("*.rs")
                check = "rustfmt --edition 2024 --check {{files}}"
                fix = "rustfmt --edition 2024 {{files}}"
            }
            ["ktlint"] {
                // Generated bindings live under beam-android/**/build/ and are
                // excluded by beam-android/.ktlintignore, so they never reach
                // this even when a build has just written them.
                glob = List("*.kt", "*.kts")
                check = "ktlint --relative {{files}}"
                fix = "ktlint --format --relative {{files}}"
            }
            ["biome"] {
                // Generated files (api.gen.ts, routeTree.gen.ts) are gitignored
                // and so never appear in the staged set.
                //
                // --no-errors-on-unmatched: biome.json scopes `files.includes`
                // to a subset of the JS/TS tree, and biome exits non-zero when
                // handed a path it is configured to ignore. Without this,
                // staging e.g. beam-web/tsconfig.json alone fails the commit.
                glob = List("*.ts", "*.tsx", "*.js", "*.mjs", "*.cjs", "*.astro")
                check = "bun biome check --no-errors-on-unmatched {{files}}"
                fix = "bun biome check --write --no-errors-on-unmatched {{files}}"
            }
        }
    }

    // Reject non-Conventional Commit messages at the point of authorship, so
    // release-please can derive versions and the changelog from git history.
    // Merge commits and `git commit --fixup/--squash` markers are exempt:
    // convco cannot parse them, and rebase resolves them before they land.
    ["commit-msg"] {
        steps {
            ["convco"] {
                check = "git rev-parse --verify --quiet MERGE_HEAD > /dev/null || grep -qE '^(fixup|squash)!' {{commit_msg_file}} || convco check --from-stdin --strip < {{commit_msg_file}}"
            }
        }
    }

    // A local approximation of .github/workflows/ci.yml. Deliberately excludes
    // the two slow gates CI still enforces -- llvm-cov coverage thresholds and
    // container image builds. Globs gate each step so a docs-only push does not
    // wait on a Rust compile.
    ["pre-push"] {
        steps {
            ["commits"] {
                check = "mise run commits:check"
                exclusive = true
            }
            ["rust-fmt"] {
                glob = List("*.rs")
                check = "mise run rust:fmt"
            }
            ["rust-clippy"] {
                glob = List("*.rs", "Cargo.toml", "*/Cargo.toml", "Cargo.lock", "rust-toolchain.toml")
                check = "mise run rust:clippy"
            }
            ["rust-test"] {
                glob = List("*.rs", "Cargo.toml", "*/Cargo.toml", "Cargo.lock")
                check = "mise run rust:test"
            }
            ["rust-deny"] {
                glob = List("Cargo.toml", "*/Cargo.toml", "Cargo.lock", "deny.toml")
                check = "mise run rust:deny"
            }
            ["rust-lockfile"] {
                glob = List("Cargo.toml", "*/Cargo.toml", "Cargo.lock")
                check = "mise run rust:lockfile"
            }
            ["ffmpeg-version"] {
                glob = List("Cargo.toml", "beam-server/Containerfile", ".github/actions/setup-ffmpeg/action.yml")
                check = "mise run check:ffmpeg-version"
            }
            // A pure grep over the tracked .rs files -- milliseconds, and it catches
            // the one mistake that would silently corrupt every mutation-testing
            // result: a test double that cargo-mutants will mutate as if it were
            // production code. See the task in mise.toml for why the cfg attribute
            // alone is not enough.
            ["mutants-skip-fakes"] {
                glob = List("*.rs")
                check = "mise run check:mutants-skip-fakes"
            }
            ["ts-check"] {
                glob = List("*.ts", "*.tsx", "*.js", "*.mjs", "*.cjs", "*.astro", "*.json")
                check = "mise run ts:check"
            }
            ["ts-typecheck"] {
                glob = List("*.ts", "*.tsx", "*.json")
                check = "mise run ts:typecheck"
            }
            ["ts-test"] {
                glob = List("*.ts", "*.tsx")
                check = "mise run ts:test"
            }
            // Without this a docs-only change is pushed unverified, because none of the ts-*
            // steps above build beam-docs. Narrower than ci.yml's `docs` filter, which also
            // watches mise.toml and the workflows; hk globs file paths, and firing a docs
            // build on every mise.toml edit is not worth the wait. CI still covers that.
            ["docs-build"] {
                glob = List("beam-docs/**")
                check = "mise run docs:build"
            }
            // The Android steps also watch beam-client-core: the Kotlin
            // bindings and the .so are generated from it, so a change there can
            // break the Android build without touching a Kotlin file.
            ["android-lint"] {
                glob = List("*.kt", "*.kts", "beam-android/**", "beam-client-core/**")
                check = "mise run android:lint"
            }
            ["android-test"] {
                glob = List("*.kt", "*.kts", "beam-android/**", "beam-client-core/**")
                check = "mise run android:test"
            }
            ["android-screenshot"] {
                glob = List("*.kt", "*.kts", "beam-android/**", "beam-client-core/**")
                check = "mise run android:screenshot"
            }
        }
    }
}
