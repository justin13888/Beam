amends "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Config.pkl"

// Git hooks for beam. Every non-trivial step shells out to a `mise run <task>`
// so the hooks, the GitHub Actions workflows, and a human at a terminal all run
// the exact same command. See mise.toml for the task definitions.
//
// Hooks are installed by `mise run setup` (or mise's postinstall hook), which
// runs `hk install --mise`. HK_MISE=1 in mise.toml wraps hook execution in
// `mise x`, so contributors without mise activated still get the pinned tools.

min_hk_version = "1.57.0"

// The base a pre-push of a new branch is diffed against, so each glob-gated
// step below sees only the branch's own changes (#282). hk 1.57.0 builds the
// pre-push file set as follows: a branch the remote already has is diffed
// against the remote's old sha; a new one against the checked-out branch's
// `refs/remotes/<remote>/<name>` if it exists, else against this value (rebound onto `<remote>` when that is not
// `origin`); and a ref that does not resolve is diffed against the empty tree,
// which hands every tracked file to every step.
//
// Remote-qualified on purpose. A bare "master" is the *local* branch, which
// nothing fetches -- `git fetch origin master` moves origin/master and leaves
// master where it was -- so in a long-lived clone or a linked worktree it
// trails upstream, and everything merged since it last moved lands in the file
// set. `commits:check` in mise.toml measures from origin/master for the same
// reason.
//
// No setting here covers a push to a URL (`git push https://... HEAD:refs/heads/x`).
// Git then passes the URL where the remote name goes, hk looks for
// `refs/remotes/<the URL>/master`, finds nothing, and falls back to the empty
// tree: a one-file change runs the Rust, Android and Apple steps over the
// whole repository. Push by remote name instead; where SSH is unavailable,
// point the remote at HTTPS (`git config remote.origin.pushurl
// https://github.com/justin13888/Beam.git`) and keep pushing to `origin`.
// That is an hk limitation, not reported upstream from here; ADR-0009 records it.
default_branch = "origin/master"

// Every step runs in hk's default shell, `sh -o errexit -c`, with GIT_DIR and
// GIT_WORK_TREE removed from its environment (#204). Each hook's `steps` sets
// it as the `default` every entry amends, so a step added later inherits it
// without naming it; a step that set its own `shell` would lose it, so none
// does. (A single `[[true]]` member predicate would say this once, but hk's
// built-in Pkl evaluator does not parse member predicates.)
//
// Git exports GIT_DIR to hooks run from a linked worktree, and hk then adds
// GIT_WORK_TREE=<worktree root> to each step it starts. Left in place, both
// reach everything a step spawns -- cargo build scripts, cargo-ndk, Gradle,
// bun -- and any of those that runs git somewhere else operates on this
// repository instead. ffmpeg-sys-next's vendored build does exactly that: its
// build script runs `git clone` into OUT_DIR, which dies with "working tree
// '<worktree>' already exists" -- only on a fresh worktree's first push, since
// a warm target/ never reruns that build script. A `mise run` from a terminal
// never saw either variable, which is why the same gate passed there.
//
// Removing them costs the steps nothing: git runs hooks from the work-tree
// root, whose `.git` file leads git (and hk's own git calls) back to the same
// repository by discovery. GIT_INDEX_FILE is deliberately kept, because in
// pre-commit it names the temporary index a `git commit -a` or `git commit
// <path>` is building, and a step that ran `git add` must write to that one.
//
// Through `shell` rather than `prefix`: hk pastes a prefix in front of the
// command text, so it would wrap only the first command of a compound script
// such as swift-format's `! command -v xcrun || ...`. `env -u` is not POSIX,
// but GNU coreutils and the BSD env macOS ships both have it. Guarded by the
// `hook-git-env` step below and `check:hook-git-env` in mise.toml.
local scrubbedShell = "env -u GIT_DIR -u GIT_WORK_TREE sh -o errexit -c"

hooks {
    // Fast, staged-file-scoped, auto-fixing. Should finish in seconds: anything
    // that needs to compile belongs in `mise run ci`, not in any hook.
    ["pre-commit"] {
        fix = true
        stage = true
        stash = "git"
        steps {
            default {
                shell = scrubbedShell
            }
            ["rustfmt"] {
                glob = List("*.rs")
                check = "rustfmt --edition 2024 --check {{files}}"
                fix = "rustfmt --edition 2024 {{files}}"
            }
            ["ktlint"] {
                // Generated bindings live under beam-android/**/build/ and are
                // excluded by beam-android/.ktlintignore, so they never reach
                // this even when a build has just written them.
                glob = List("*.kt", "*.kts")
                check = "ktlint --relative {{files}}"
                fix = "ktlint --format --relative {{files}}"
            }
            ["swift-format"] {
                // The generated UniFFI bindings live under
                // beam-apple/Packages/BeamKit/Sources/BeamCoreBindings, which
                // is gitignored and so never reaches a staged set.
                //
                // swift-format ships inside Xcode rather than as a pinned mise
                // tool, so unlike ktlint it simply is not there on Linux. The
                // guard makes this a no-op where xcrun is absent instead of
                // failing every commit; `apple:lint` in `mise run ci` and CI both
                // run it on macOS, so nothing goes unchecked.
                glob = List("*.swift")
                check = "! command -v xcrun > /dev/null 2>&1 || xcrun swift-format lint --strict {{files}}"
                fix = "! command -v xcrun > /dev/null 2>&1 || xcrun swift-format format --in-place {{files}}"
            }
            ["biome"] {
                // Generated files (api.gen.ts, routeTree.gen.ts) are gitignored
                // and so never appear in the staged set.
                //
                // Through mise, like the pre-push steps, so the tasks' `deps:js`
                // dependency installs node_modules on a fresh checkout's first
                // JS commit and is skipped, without starting bun, after that.
                // This is the only pre-commit step that needs it, so there is
                // no parallel-install race to serialise. See the tasks in
                // mise.toml for the biome flags.
                glob = List("*.ts", "*.tsx", "*.js", "*.mjs", "*.cjs", "*.astro")
                check = "mise run ts:biome {{files}}"
                fix = "mise run ts:biome:fix {{files}}"
            }
        }
    }

    // Reject non-Conventional Commit messages at the point of authorship, so
    // release-please can derive versions and the changelog from git history.
    // Merge commits and `git commit --fixup/--squash` markers are exempt:
    // convco cannot parse them, and rebase resolves them before they land.
    ["commit-msg"] {
        steps {
            default {
                shell = scrubbedShell
            }
            ["convco"] {
                check = "git rev-parse --verify --quiet MERGE_HEAD > /dev/null || grep -qE '^(fixup|squash)!' {{commit_msg_file}} || convco check --from-stdin --strip < {{commit_msg_file}}"
            }
        }
    }

    // Compiles nothing (#478). Every step here is a static check that reads
    // files -- commit messages, formatting, the lockfile, version pins, grep
    // guards -- and finishes in seconds. Branches are pushed after every
    // commit, so any build or test suite here repeated the full gates many
    // times over for one change, and a merge push re-ran them on a head that
    // `mise run ci` had already passed.
    //
    // The gate is `mise run ci` (with CI's `ci-ok`), run at the head before a
    // merge: clippy, the tests, cargo-deny, the TypeScript, docs, Android and
    // Apple suites. `rust:clippy:affected`, `rust:test:affected` and
    // `ts:test:related` are there for a quick local check of what a change
    // touches; no hook runs them. See ADR-0009.
    ["pre-push"] {
        steps {
            default {
                shell = scrubbedShell
            }
            ["commits"] {
                check = "mise run commits:check"
                exclusive = true
            }
            // Milliseconds, and deliberately unglobbed: it probes the hook's
            // own environment, which no file change predicts. From a linked
            // worktree this is the live check that `scrubbedShell` above held;
            // from the main checkout git exports nothing and it passes
            // trivially, which is why `check:hook-git-env` also drives it
            // under a simulated linked-worktree hook. See that task.
            ["hook-git-env"] {
                check = "mise run check:hook-git-env:probe"
            }
            // The pushed .rs files only: pre-commit already ran rustfmt on each
            // staged one, and `rust:fmt` over the whole tree is `ci`'s.
            ["rust-fmt"] {
                glob = List("*.rs")
                check = "mise run rust:fmt:files {{files}}"
            }
            // No clippy, tests or cargo-deny: they compile the workspace or,
            // for deny, fetch an advisory database that can fail a push for an
            // advisory published since, whatever the push changed. All three
            // are `ci`'s.
            ["rust-lockfile"] {
                glob = List("Cargo.toml", "*/Cargo.toml", "Cargo.lock")
                check = "mise run rust:lockfile"
            }
            // Cargo.lock is in the glob because the manifest string is a caret
            // requirement: the FFmpeg minor that ffmpeg-sys-next vendors is decided
            // by the resolved version, so a lockfile-only bump moves it without
            // touching any of the other three files. See the task in mise.toml.
            ["ffmpeg-version"] {
                glob = List("Cargo.toml", "Cargo.lock", "beam-server/Containerfile", ".github/actions/setup-ffmpeg/action.yml")
                check = "mise run check:ffmpeg-version"
            }
            // The server's reader of the variable and every image build that
            // must pass it; see the task in mise.toml.
            ["build-commit"] {
                glob = List("mise.toml", "beam-server/Containerfile", ".github/workflows/release.yml", "beam-server/src/metrics.rs")
                check = "mise run check:build-commit"
            }
            // Pure YAML/TOML parsing -- milliseconds. Narrower than ci.yml's
            // `compose` filter, which also watches dex/: the gate reads only the compose files,
            // mise.toml (for dev:up's OIDC scope and admin-claim wiring) and
            // .env.example (for the variables an operator is told to set).
            ["compose-invariants"] {
                glob = List("compose*.yaml", "mise.toml", ".env.example")
                check = "mise run check:compose-invariants"
            }
            // Seconds once kubeconform's schema cache is warm. mise.toml is in
            // the glob because the three tasks, and the helm and kubeconform
            // pins, live there. ci.yml's helm-chart job runs the same three.
            ["helm-chart"] {
                glob = List("charts/**", "mise.toml")
                check = "mise run helm:lint && mise run helm:template && mise run check:chart-invariants"
            }
            // A pure grep over the tracked .rs files -- milliseconds, and it catches
            // the one mistake that would silently corrupt every mutation-testing
            // result: a test double that cargo-mutants will mutate as if it were
            // production code. See the task in mise.toml for why the cfg attribute
            // alone is not enough.
            ["mutants-skip-fakes"] {
                glob = List("*.rs")
                check = "mise run check:mutants-skip-fakes"
            }
            // Milliseconds: `git ls-files` and a line count per Rust or Kotlin
            // file. Fires when a governed file or the baseline changes, so a file
            // that crossed its limit, or a baseline entry made stale by a split,
            // is caught before the push rather than by ci.yml's file-size job.
            // The shrink-only comparison runs against the merge base with
            // origin/master here; see scripts/check-file-size.sh (#362).
            ["file-size"] {
                glob = List("*.rs", "*.kt", "*.kts", "scripts/file-size-baseline.txt")
                check = "mise run check:file-size"
            }
            // No TypeScript, docs, Android or Apple step: each installs
            // node_modules, an SDK or a toolchain and builds or tests a project
            // -- minutes per push. pre-commit already ran biome, ktlint and
            // swift-format on every staged file; the rest is `ci`'s.
        }
    }
}
