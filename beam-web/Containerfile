# ----------------------------------------------------
# Build: Build the application using Bun
#
# beam-web/openapi.json must exist in the build context. It is gitignored and
# generated from the Rust types by `mise run codegen:openapi`; CI and the
# release workflow run that task before building this image. Generating it
# inside the image would mean compiling FFmpeg and the entire Rust workspace
# just to emit a JSON file.
# ----------------------------------------------------
FROM docker.io/oven/bun:1.4.0-debian AS builder

# Accept build arguments for environment variables
ARG C_APP_TITLE=Beam
ARG C_STREAM_SERVER_URL=http://localhost:8000

WORKDIR /app

# Copy workspace root package files and all workspace member package.json files for dependency install
COPY package.json bun.lock ./
COPY beam-web/package.json ./beam-web/
COPY beam-docs/package.json ./beam-docs/

# Install dependencies from workspace root
RUN bun install --frozen-lockfile

# Copy beam-web source, including the pre-generated OpenAPI spec
COPY beam-web ./beam-web

WORKDIR /app/beam-web
RUN test -f openapi.json || { \
    echo "beam-web/openapi.json is missing; run 'mise run codegen:openapi' first" >&2; \
    exit 1; \
    }

# Generate TypeScript types from the OpenAPI spec (src/api.gen.ts is gitignored)
RUN bun run codegen:openapi

# Build the application with environment variables
ENV C_APP_TITLE=${C_APP_TITLE}
ENV C_STREAM_SERVER_URL=${C_STREAM_SERVER_URL}
RUN bun run build

# ----------------------------------------------------
# Serve statically-built web app with HTTP (caching handled externally)
# ----------------------------------------------------
FROM docker.io/caddy:2.11.4-alpine

# Copy built assets from builder stage (bun run build outputs to /app/beam-web/dist)
COPY --from=builder /app/beam-web/dist /srv

# Copy Caddyfile
COPY <<EOF /etc/caddy/Caddyfile
{
    auto_https off
    admin off
}

:80 {
    root * /srv
    encode gzip zstd
    file_server
    try_files {path} /index.html

    header {
        # Security headers
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Cache static assets
    @static {
        path *.js *.css *.woff *.woff2 *.ttf *.eot *.ico *.png *.jpg *.jpeg *.gif *.svg *.webp
    }
    header @static Cache-Control "public, max-age=31536000, immutable"
}
EOF

EXPOSE 80
