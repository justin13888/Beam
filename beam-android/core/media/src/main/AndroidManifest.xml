<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Playback continues while the app is backgrounded, which since API 34
         requires the foreground service type to be declared here as well as
         requested at runtime. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Media3 posts the transport-control notification; without this the
         controls are silently absent on API 33 and above. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Downloads continue in the background and are rescheduled by the
         platform when their network constraints are met again. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!--
          Exported deliberately, and it has to be. A MediaSessionService is
          discovered by external controllers (the system media notification,
          Bluetooth and headset buttons, Android Auto, Assistant), and an
          unexported one is invisible to all of them, which is most of the
          reason for having a media session at all. It is guarded by the
          MediaSession's own controller connection check rather than by a
          manifest permission, which is the mechanism Media3 provides.
        -->
        <service
            android:name=".session.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <service
            android:name=".download.BeamDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="androidx.media3.exoplayer.downloadService.action.RESTART" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
