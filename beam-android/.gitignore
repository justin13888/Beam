# Gradle
.gradle/
build/
local.properties
.cxx/

# Produced by `mise run core:android` -- cross-compiled from beam-client-core,
# never edited by hand. Regenerate rather than committing ~60 MB per ABI.
core/ffi/src/main/jniLibs/

# Produced by `mise run core:bindgen`. Generated from the built library, so it
# is only ever as current as the .so it describes.
core/ffi/build/generated/

# Roborazzi writes failure diffs beside the reference images; the references
# themselves are committed, the diffs are not.
**/src/test/screenshots/*_compare.png
**/src/test/screenshots/*_actual.png
