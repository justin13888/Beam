<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The launch theme only. Everything after the first frame is Compose, so
      this exists to make the window match the app's own background rather than
      flashing the platform default before Compose has drawn anything.
    -->
    <style name="Theme.Beam.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Beam</item>
    </style>

    <style name="Theme.Beam" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
