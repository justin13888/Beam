# beam-server configuration for running on the host (cargo run -p beam-server).
# Copy to beam-server/.env. Full reference: docs/operations/configuration.md

# Server binding address (format: host:port)
BEAM_BIND_ADDRESS=0.0.0.0:8000

# Externally-visible base URL of this server
BEAM_SERVER_URL=http://localhost:8000

# Logging configuration (trace, debug, info, warn, error)
RUST_LOG=beam_server=info

# Database connection URL
BEAM_DATABASE_URL=postgres://beam:password@localhost:5432/beam

# Apply schema migrations automatically at startup
BEAM_AUTO_MIGRATE=true

# Storage paths: read-only media library and server-writable data directory
BEAM_VIDEO_DIR=./videos
BEAM_DATA_DIR=./data

# Web client origin (OIDC callback redirect target and CSRF-allowed Origin)
BEAM_WEB_URL=http://localhost:5173

# OIDC login (all three required together; login stays disabled with a clear
# error until they are set). For local dev, the bundled Dex works -- but it is
# opt-in: start it with `mise run dev:up` (or `--profile dev-idp`), or nothing
# answers here. The host and the server container must use this exact string:
# `openidconnect` requires the discovery document's `issuer` to equal this
# value, and Dex self-reports `dex.beam.localhost`, so `localhost:5556` is
# rejected even though Dex still answers on it.
#BEAM_OIDC_ISSUER=http://dex.beam.localhost:5556/dex
#BEAM_OIDC_CLIENT_ID=beam
#BEAM_OIDC_CLIENT_SECRET=beam-dev-secret
# Admin is granted by an IdP-asserted ID-token claim (issue #85), not the server.
# Name the claim (e.g. groups) and, for a value/array match, its expected value.
#BEAM_OIDC_ADMIN_CLAIM=groups
#BEAM_OIDC_ADMIN_VALUE=beam-admin

# Metadata enrichment (optional)
#BEAM_TMDB_API_TOKEN=
BEAM_ANILIST_ENABLED=true
